---
// Image grid that opens a full-screen viewer. Captions are shown like
// film-edge markings under each frame.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { langFromUrl } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  items: { image: ImageMetadata; caption?: string }[];
  label?: string;
  variant?: 'scans' | 'photos';
}
const t = useTranslations(langFromUrl(Astro.url));
const { items, label = t('service.gallery'), variant = 'photos' } = Astro.props;

const frames = await Promise.all(
  items.map(async (item, i) => ({
    ...item,
    full: (await getImage({ src: item.image, width: Math.min(item.image.width, 2200), format: 'webp' })).src,
    number: String(i + 1).padStart(2, '0'),
  })),
);
---

<div class:list={['gallery', `gallery--${variant}`]} data-gallery>
  {
    frames.map((frame) => (
      <figure class="frame">
        <a href={frame.full} data-lightbox data-caption={frame.caption ?? ''} aria-label={`${t('gallery.open', { n: frame.number })}${frame.caption ? `: ${frame.caption}` : ''}`}>
          <Image
            src={frame.image}
            alt={frame.caption ?? ''}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1100px) 400px, (min-width: 640px) 45vw, 92vw"
            loading="lazy"
          />
        </a>
        <figcaption>
          <span class="num">{frame.number}</span>
          {frame.caption && <span>{frame.caption}</span>}
        </figcaption>
      </figure>
    ))
  }
</div>

<dialog class="lightbox" aria-label={label} data-lightbox-dialog>
  <img alt="" data-lightbox-img />
  <p class="lb-caption" data-lightbox-caption></p>
  <button class="lb-btn lb-close" type="button" aria-label={t('gallery.close')} data-lightbox-close><Icon name="close" /></button>
  <button class="lb-btn lb-prev" type="button" aria-label={t('gallery.prev')} data-lightbox-prev><Icon name="chevron-left" /></button>
  <button class="lb-btn lb-next" type="button" aria-label={t('gallery.next')} data-lightbox-next><Icon name="chevron-right" /></button>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.dataset.caption || '';
      caption.textContent = [String(index + 1).padStart(2, '0'), link.dataset.caption].filter(Boolean).join('  ·  ');
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>

<style>
  .gallery {
    --gap: clamp(16px, 2.5vw, 28px);
  }

  /* scans keep their own aspect ratio (masonry columns) */
  .gallery--scans {
    columns: 3 260px;
    column-gap: var(--gap);
  }

  .gallery--scans .frame {
    break-inside: avoid;
    margin-bottom: var(--gap);
  }

  .gallery--photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--gap);
  }

  .frame {
    margin: 0;
  }

  .frame a {
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
    cursor: zoom-in;
  }

  .frame :global(img) {
    width: 100%;
    transition: transform 0.6s var(--ease), opacity 0.3s var(--ease);
  }

  .gallery--photos .frame :global(img) {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .frame a:hover :global(img) {
    transform: scale(1.03);
  }

  figcaption {
    display: flex;
    gap: 14px;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .num {
    color: var(--yellow);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px clamp(16px, 6vw, 96px) 72px;
    border: 0;
    background: rgb(8 8 7 / 0.97);
    color: var(--text);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 160px);
    object-fit: contain;
  }

  .lb-caption {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yellow);
    white-space: pre;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
  }

  .lb-btn:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }

  .lb-btn :global(svg) {
    width: 22px;
    height: 22px;
  }

  .lb-close {
    top: 16px;
    right: 16px;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-prev {
    left: 16px;
  }

  .lb-next {
    right: 16px;
  }

  @media (max-width: 640px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 16px;
      transform: none;
    }
  }
</style>
