---
interface Props {
  label?: string;
  title: string;
  intro?: string;
}
const { label, title, intro } = Astro.props;
---

<header class="page-header container">
  {label && <p class="label">{label}</p>}
  <h1 class="h1">{title}</h1>
  {intro && <p class="lead">{intro}</p>}
  {Astro.slots.has('default') && <div class="actions"><slot /></div>}
</header>

<style>
  .page-header {
    padding-top: clamp(40px, 8vw, 96px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .label {
    margin-bottom: 20px;
  }

  .lead {
    margin-top: 24px;
  }

  .actions {
    margin-top: 32px;
  }
</style>
