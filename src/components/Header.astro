---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { LOCALES, LANG_NAMES, langFromUrl, localizePath, switchLangPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getLocalized } from '../i18n/content';
import { getSite } from '../i18n/site';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const site = getSite(lang);
const link = (path: string) => url(localizePath(path, lang));

const pages = (await getLocalized('pages', lang)).sort((a, b) => a.data.order - b.data.order);
const links = [
  ...pages.map((p) => ({ href: link(`/${p.id}/`), label: p.data.nav_label })),
  { href: link('/events/'), label: t('nav.events') },
  { href: link('/blog/'), label: t('nav.blog') },
  { href: link('/contact/'), label: t('nav.contact') },
];

// The 404 page has no counterpart, so its language switch goes to the home page.
const isNotFound = /\/404(\.html)?\/?$/.test(Astro.url.pathname);
const langHref = (l: (typeof LOCALES)[number]) => url(isNotFound ? localizePath('/', l) : switchLangPath(Astro.url.pathname, l));

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => current === href || (href !== link('/') && current.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={link('/')} aria-label={t('nav.home')}>
      <Logo class="brand-logo" />
    </a>

    <div class="lang-switch" role="group" aria-label={t('nav.language')}>
      {
        LOCALES.map((l) =>
          l === lang ? (
            <span class="lang-current" lang={l} aria-current="true" title={LANG_NAMES[l]}>{l.toUpperCase()}</span>
          ) : (
            <a href={langHref(l)} lang={l} hreflang={l} title={LANG_NAMES[l]}>{l.toUpperCase()}</a>
          ),
        )
      }
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">{t('nav.menu')}</span>
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>

    <nav id="site-nav" class="nav" aria-label={t('nav.main')}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn store" href={site.store_url} target="_blank" rel="noopener">
        {t('nav.store')} <Icon name="external" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 960px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgb(12 12 10 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--header-h);
  }

  .nav {
    order: 1;
  }

  .lang-switch {
    order: 2;
    display: flex;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .lang-switch a,
  .lang-current {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 30px;
    border-radius: 3px;
    text-decoration: none;
  }

  .lang-switch a {
    color: var(--text-muted);
  }

  .lang-switch a:hover {
    color: var(--text);
    background: var(--bg-raised);
  }

  .lang-current {
    background: var(--yellow);
    color: var(--yellow-ink);
  }

  .menu-toggle {
    order: 3;
  }

  .brand {
    display: block;
    margin-right: auto;
    color: var(--yellow);
    flex: none;
  }

  .brand:hover {
    color: var(--yellow-bright);
  }

  .brand :global(.brand-logo) {
    width: 74px;
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav ul a {
    position: relative;
    display: block;
    padding: 10px 12px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
  }

  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    color: var(--text);
  }

  .nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background: var(--yellow);
  }

  .store {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.875rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 10px;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .menu-toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  .menu-toggle :global(.icon-close) {
    display: none;
  }

  @media (max-width: 959px) {
    .menu-toggle {
      display: block;
    }

    .is-open .menu-toggle :global(.icon-open) {
      display: none;
    }

    .is-open .menu-toggle :global(.icon-close) {
      display: block;
    }

    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding: 24px var(--gutter) 40px;
      background: var(--bg);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0s linear 0.2s;
    }

    .is-open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
    }

    .nav ul a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      font-size: 2rem;
      font-stretch: 72%;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--text);
    }

    .nav ul a[aria-current='page'] {
      color: var(--yellow);
    }

    .nav ul a[aria-current='page']::after {
      display: none;
    }

    .store {
      align-self: flex-start;
      min-height: 48px;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
