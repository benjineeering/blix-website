---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { url } from '../lib/url';

const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const links = [
  ...pages.map((p) => ({ href: url(`/${p.id}/`), label: p.data.nav_label })),
  { href: url('/events/'), label: 'Events' },
  { href: url('/blog/'), label: 'Blog' },
  { href: url('/contact/'), label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => current === href || (href !== url('/') && current.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label="blix — home">
      <Logo class="brand-logo" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn store" href={site.store_url} target="_blank" rel="noopener">
        Store <Icon name="external" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 960px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgb(12 12 10 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .brand {
    display: block;
    color: var(--yellow);
    flex: none;
  }

  .brand:hover {
    color: var(--yellow-bright);
  }

  .brand :global(.brand-logo) {
    width: 74px;
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav ul a {
    position: relative;
    display: block;
    padding: 10px 12px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
  }

  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    color: var(--text);
  }

  .nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background: var(--yellow);
  }

  .store {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.875rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 10px;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .menu-toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  .menu-toggle :global(.icon-close) {
    display: none;
  }

  @media (max-width: 959px) {
    .menu-toggle {
      display: block;
    }

    .is-open .menu-toggle :global(.icon-open) {
      display: none;
    }

    .is-open .menu-toggle :global(.icon-close) {
      display: block;
    }

    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding: 24px var(--gutter) 40px;
      background: var(--bg);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0s linear 0.2s;
    }

    .is-open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
    }

    .nav ul a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      font-size: 2rem;
      font-stretch: 72%;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--text);
    }

    .nav ul a[aria-current='page'] {
      color: var(--yellow);
    }

    .nav ul a[aria-current='page']::after {
      display: none;
    }

    .store {
      align-self: flex-start;
      min-height: 48px;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
