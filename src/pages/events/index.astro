---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import { sortEvents } from '../../lib/time';
import { url } from '../../lib/url';

const { upcoming, past } = sortEvents(await getCollection('events', (e) => !e.data.draft));

const pastByYear = Object.entries(
  past.reduce<Record<string, typeof past>>((acc, event) => {
    (acc[event.data.date.slice(0, 4)] ??= []).push(event);
    return acc;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<Base title="Events" description="Workshops, photo walks, exhibitions and parties at blix in Munich.">
  <PageHeader label="Workshops · Photo walks · Exhibitions" title="Events" intro="Darkroom and studio workshops, photo walks through Munich, exhibitions and the occasional party.">
    <div class="btn-row">
      <a class="btn" href={url('/events.ics')}><Icon name="calendar" /> Subscribe to calendar</a>
      <a class="btn" href={site.instagram_url} target="_blank" rel="noopener"><Icon name="instagram" /> Follow on Instagram</a>
    </div>
  </PageHeader>

  <section class="container" aria-labelledby="upcoming-heading">
    <div class="section-head">
      <h2 class="h2" id="upcoming-heading">Coming up</h2>
    </div>
    {
      upcoming.length > 0 ? (
        <div class="grid">
          {upcoming.map((event) => <EventCard event={event} />)}
        </div>
      ) : (
        <div class="empty">
          <p class="h3">Nothing scheduled right now.</p>
          <p class="muted">
            New workshops and photo walks are announced on <a href={site.instagram_url} target="_blank" rel="noopener">Instagram</a> and in our{' '}
            <a href={site.newsletter_url} target="_blank" rel="noopener">newsletter</a> first.
          </p>
        </div>
      )
    }
  </section>

  {
    pastByYear.map(([year, events]) => (
      <section class="container past" aria-labelledby={`past-${year}`}>
        <div class="section-head">
          <h2 class="h2" id={`past-${year}`}>
            <span class="label label--muted">Past events</span>
            {year}
          </h2>
        </div>
        <div class="grid grid--compact">
          {events.map((event) => <EventCard event={event} compact />)}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }

  .grid--compact {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .past {
    margin-top: var(--section);
  }

  .past h2 .label {
    display: block;
    margin-bottom: 12px;
  }

  .empty {
    display: grid;
    gap: 10px;
    padding: clamp(28px, 5vw, 48px);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }
</style>
