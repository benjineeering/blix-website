---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found" noindex>
  <section class="container lost">
    <p class="label">Error 404 · Frame missing</p>
    <h1 class="display">Overexposed.</h1>
    <p class="lead">This page doesn't exist (anymore). Maybe it was on the old website — try one of these instead.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={url('/')}>Home</a>
      <a class="btn" href={url('/lab/')}>Lab prices</a>
      <a class="btn" href={url('/events/')}>Events</a>
      <a class="btn" href={url('/contact/')}>Contact</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 28px;
    justify-items: start;
    padding-block: clamp(64px, 14vw, 160px);
  }
</style>
