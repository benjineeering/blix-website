---
// Shown after sending the contact form in browsers without JavaScript.
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
---

<Base title="Message sent" noindex>
  <section class="container thanks">
    <p class="label">Message sent</p>
    <h1 class="h1">Thanks!</h1>
    <p class="lead">Your message is on its way. We usually reply within a few days.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={url('/')}>Back to the home page</a>
      <a class="btn" href={url('/events/')}>See what's on</a>
    </div>
  </section>
</Base>

<style>
  .thanks {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-block: clamp(64px, 12vw, 140px);
  }
</style>
