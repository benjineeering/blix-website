---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { dateLabel, timeRange, isUpcoming } from '../../../lib/time';
import { url } from '../../../lib/url';
import { LOCALES, DEFAULT_LANG, langFromParam, localizePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getLocalized, type Localized } from '../../../i18n/content';
import { getSite } from '../../../i18n/site';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const event of await getLocalized('events', lang)) {
      if (event.data.draft) continue;
      paths.push({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, slug: event.id }, props: { event } });
    }
  }
  return paths;
}

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const site = getSite(lang);
const { event } = Astro.props as { event: Localized<'events'> };
const { Content } = await render(event.bodyEntry);
const { title, summary, poster, location, ticket_url } = event.data;
const upcoming = isUpcoming(event);
const time = timeRange(event);
const shareImage = poster ? (await getImage({ src: poster, width: 1200, format: 'jpg' })).src : undefined;
---

<Base title={title} description={summary} image={shareImage}>
  <article class="container event">
    <a class="back link-arrow" href={url(localizePath('/events/', lang))}><Icon name="chevron-left" /> {t('event.all')}</a>

    <div class="layout">
      <div class="poster">
        {poster && <Image src={poster} alt={t('event.poster', { title })} widths={[480, 800, 1200]} sizes="(min-width: 960px) 480px, 92vw" loading="eager" />}
      </div>

      <div class="details">
        <p class="label">{upcoming ? t('event.upcoming') : t('event.pastEvent')}</p>
        <h1 class="h1">{title}</h1>

        <dl class="meta">
          <div>
            <dt><Icon name="calendar" /><span class="visually-hidden">{t('event.date')}</span></dt>
            <dd>{dateLabel(event, lang)}</dd>
          </div>
          {
            time && (
              <div>
                <dt><Icon name="clock" /><span class="visually-hidden">{t('event.time')}</span></dt>
                <dd class="mono">{time}</dd>
              </div>
            )
          }
          <div>
            <dt><Icon name="pin" /><span class="visually-hidden">{t('event.location')}</span></dt>
            <dd>{location ?? `${site.name}, ${site.address.street}`}</dd>
          </div>
        </dl>

        {
          upcoming && (
            <div class="btn-row">
              {ticket_url && (
                <a class="btn btn--primary" href={ticket_url} target="_blank" rel="noopener">
                  <Icon name="ticket" /> {t('event.getTickets')}
                </a>
              )}
              <a class="btn" href={url(`/events/${event.id}.ics`)}>
                <Icon name="calendar" /> {t('event.addToCalendar')}
              </a>
            </div>
          )
        }

        {!event.bodyTranslated && <p class="untranslated label label--muted">{t('content.onlyOther')}</p>}
        <div class="prose" lang={event.bodyTranslated ? undefined : 'en'}>
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .event {
    padding-top: clamp(24px, 5vw, 56px);
  }

  .back {
    margin-bottom: clamp(24px, 4vw, 48px);
    color: var(--text-muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .poster {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .poster :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .details .h1 {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
  }

  .meta {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 20px 0;
    border-block: 1px solid var(--line);
  }

  .meta div {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .meta dt {
    display: flex;
    color: var(--yellow);
  }

  .meta dt :global(svg) {
    width: 20px;
    height: 20px;
  }

  .meta dd {
    margin: 0;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .poster {
      position: static;
      max-width: 520px;
    }
  }
</style>
