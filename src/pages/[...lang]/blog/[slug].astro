---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate } from '../../../lib/time';
import { url } from '../../../lib/url';
import { LOCALES, DEFAULT_LANG, langFromParam, localizePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getLocalized, type Localized } from '../../../i18n/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const post of await getLocalized('blog', lang)) {
      if (post.data.draft) continue;
      paths.push({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, slug: post.id }, props: { post } });
    }
  }
  return paths;
}

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { post } = Astro.props as { post: Localized<'blog'> };
const { Content } = await render(post.bodyEntry);
const { title, date, author, excerpt, cover } = post.data;
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<Base title={title} description={excerpt} image={shareImage} type="article">
  <article>
    <header class="container head">
      <a class="back link-arrow" href={url(localizePath('/blog/', lang))}><Icon name="chevron-left" /> {t('blog.title')}</a>
      <p class="label">
        <time datetime={date}>{formatDate(date, { weekday: false, lang })}</time>{author && ` · ${author}`}
      </p>
      <h1 class="title">{title}</h1>
      {excerpt && <p class="lead">{excerpt}</p>}
    </header>

    {
      cover && (
        <div class="container cover">
          <Image src={cover} alt="" widths={[800, 1400, 2000]} sizes="(min-width: 1320px) 1240px, 94vw" loading="eager" />
        </div>
      )
    }

    <div class="container body">
      {!post.bodyTranslated && <p class="untranslated label label--muted">{t('content.onlyOther')}</p>}
      <div class="prose" lang={post.bodyTranslated ? undefined : 'en'}>
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-top: clamp(24px, 5vw, 56px);
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .back {
    margin-bottom: 12px;
    color: var(--text-muted);
  }

  .title {
    max-width: 18ch;
    font-size: clamp(2.5rem, 6.5vw, 5.25rem);
    font-stretch: 72%;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
  }

  .cover :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(40px, 6vw, 72px);
  }

  .body .untranslated {
    width: 100%;
    max-width: 42rem;
  }

  .body .prose {
    width: 100%;
    font-size: 1.125rem;
  }
</style>
