---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Base title="Blog" description="Notes from the blix lab: scanning, film, workshops and our community.">
  <PageHeader label="Notes from the lab" title="Blog" intro="How we scan, what we've learned about film, and what's happening in our community." />

  <section class="container">
    <div class="posts">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: clamp(40px, 6vw, 64px) clamp(24px, 4vw, 48px);
  }
</style>
