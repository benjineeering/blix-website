---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import OpenStatus from '../components/OpenStatus.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { openingHours } from '../lib/time';
import { url } from '../lib/url';
---

<Base title="Contact" description={site.contact_intro}>
  <PageHeader label="Say hello" title="Contact" intro={site.contact_intro} />

  <div class="container">
    <a class="email" href={`mailto:${site.email}`}>
      <span class="label">Email us</span>
      <span class="address">{site.email}</span>
      <Icon name="arrow" class="arrow" />
    </a>

    <div class="cards">
      <section class="card">
        <h2 class="label">Visit</h2>
        <address>
          {site.name}<br />
          {site.address.street}<br />
          {site.address.postcode} {site.address.city}
        </address>
        <a class="link-arrow" href={site.map_url} target="_blank" rel="noopener">Open in maps <Icon name="external" /></a>
      </section>

      <section class="card">
        <h2 class="label">Opening hours</h2>
        <dl class="hours">
          {
            openingHours.map((h) => (
              <div>
                <dt>{h.longLabel}</dt>
                <dd class="mono">{h.time}</dd>
              </div>
            ))
          }
        </dl>
        {site.hours_note && <p class="muted">{site.hours_note}</p>}
        <OpenStatus />
      </section>

      <section class="card">
        <h2 class="label">Stay in the loop</h2>
        <ul class="links">
          <li><a href={site.instagram_url} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a></li>
          <li><a href={site.newsletter_url} target="_blank" rel="noopener"><Icon name="mail" /> Newsletter</a></li>
          <li><a href={url('/events.ics')}><Icon name="calendar" /> Events calendar</a></li>
          {site.phone && <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="arrow" /> {site.phone}</a></li>}
        </ul>
      </section>
    </div>

    {
      site.contact_form_endpoint && (
        <section class="form-section" aria-labelledby="form-heading">
          <h2 class="h2" id="form-heading">Send a message</h2>
          <form class="form" action={site.contact_form_endpoint} method="POST">
            <label>
              <span>Name *</span>
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Email *</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              <span>Phone</span>
              <input name="phone" type="tel" autocomplete="tel" />
            </label>
            <label class="full">
              <span>Details *</span>
              <textarea name="message" rows="6" required />
            </label>
            <p class="full privacy muted">
              By sending this form you agree that we store your details to answer your request. See our{' '}
              <a href={url('/datenschutz/')}>privacy policy</a>.
            </p>
            <button class="btn btn--primary" type="submit">Send message <Icon name="arrow" /></button>
          </form>
        </section>
      )
    }
  </div>
</Base>

<style>
  .email {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px 24px;
    padding: clamp(28px, 5vw, 48px);
    border: 1px solid var(--yellow);
    border-radius: var(--radius);
    background: var(--yellow-wash);
    text-decoration: none;
  }

  .email .label {
    grid-column: 1 / -1;
  }

  .address {
    font-size: clamp(1.5rem, 5vw, 3.5rem);
    font-stretch: 72%;
    font-weight: 800;
    line-height: 1;
    word-break: break-word;
  }

  .email :global(.arrow) {
    width: clamp(28px, 4vw, 44px);
    height: auto;
    color: var(--yellow);
    transition: transform 0.2s var(--ease);
  }

  .email:hover {
    color: var(--text);
  }

  .email:hover :global(.arrow) {
    transform: translateX(6px);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(16px, 2.5vw, 28px);
    margin-top: clamp(16px, 2.5vw, 28px);
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(24px, 3vw, 32px);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  address {
    font-style: normal;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .hours {
    margin: 0;
  }

  .hours div + div {
    margin-top: 8px;
  }

  .hours dd {
    margin: 0;
    color: var(--text-muted);
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links li + li {
    margin-top: 10px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .links :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--text-faint);
  }

  .form-section {
    margin-top: var(--section);
  }

  .form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    max-width: 860px;
    margin-top: 32px;
  }

  .form label {
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .form .full {
    grid-column: 1 / -1;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }

  .form input:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--yellow);
  }

  .privacy {
    font-size: 0.8125rem;
  }

  .form button {
    justify-self: start;
  }
</style>
